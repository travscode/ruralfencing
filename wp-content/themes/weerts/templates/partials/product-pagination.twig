{# Same visual language as blog-pagination.twig, tighter top margin, ellipsis support. #}
{% if pagination and pagination.pages %}
	<nav class="mt-10 flex justify-center lg:mt-[60px]" aria-label="Pagination">
		<div class="inline-flex flex-wrap items-stretch">
			{% if pagination.prev %}
				<a class="flex h-[46px] w-[40px] items-center justify-center rounded-l-md border border-birch text-birch no-underline transition-colors duration-200 hover:bg-white" href="{{ pagination.prev.link }}" aria-label="Previous page">
					{% include 'icons/arrow-right.twig' with { class: 'h-3 w-3 rotate-180' } only %}
				</a>
			{% else %}
				<span class="flex h-[46px] w-[40px] items-center justify-center rounded-l-md border border-birch/40 text-birch/40">
					{% include 'icons/arrow-right.twig' with { class: 'h-3 w-3 rotate-180' } only %}
				</span>
			{% endif %}

			{% for page in pagination.pages %}
				{% if page.ellipsis|default(false) %}
					<span class="-ml-px flex h-[46px] min-w-[40px] items-center justify-center border border-birch px-2 text-birch/60">…</span>
				{% elseif page.link %}
					<a class="-ml-px flex h-[46px] min-w-[40px] items-center justify-center border border-birch px-3 text-birch no-underline transition-colors duration-200 hover:bg-white" href="{{ page.link }}">{{ page.title }}</a>
				{% else %}
					<span class="-ml-px flex h-[46px] min-w-[40px] items-center justify-center border border-deep-green bg-deep-green px-3 font-bold text-white" aria-current="page">{{ page.title }}</span>
				{% endif %}
			{% endfor %}

			{% if pagination.next %}
				<a class="-ml-px flex h-[46px] w-[40px] items-center justify-center rounded-r-md border border-birch text-birch no-underline transition-colors duration-200 hover:bg-white" href="{{ pagination.next.link }}" aria-label="Next page">
					{% include 'icons/arrow-right.twig' with { class: 'h-3 w-3' } only %}
				</a>
			{% else %}
				<span class="-ml-px flex h-[46px] w-[40px] items-center justify-center rounded-r-md border border-birch/40 text-birch/40">
					{% include 'icons/arrow-right.twig' with { class: 'h-3 w-3' } only %}
				</span>
			{% endif %}
		</div>
	</nav>
{% endif %}
