{% set breadcrumb_items = breadcrumb_items|default([]) %}
{% set banner_icon_url = banner_icon_url|default('') %}
{% set title = title|default('') %}

<section class="bg-goldenrod px-6 pb-12 pt-5 lg:px-[100px] lg:pb-[90px]">
	<div class="mx-auto flex w-full max-w-[1720px] flex-col gap-8 lg:gap-[70px]">
		<nav class="text-t7 leading-[23px] text-birch">
			{% for item in breadcrumb_items %}
				{% if loop.first %}
					<a class="underline" href="{{ item.url }}">{{ item.title }}</a>
				{% elseif item.url %}
					<span> &gt; </span><a href="{{ item.url }}">{{ item.title }}</a>
				{% else %}
					<span> &gt; </span><span>{{ item.title }}</span>
				{% endif %}
			{% endfor %}
		</nav>

		<div class="flex items-center gap-4 lg:gap-10">
			{% if banner_icon_url %}
				<img class="h-8 w-auto flex-none lg:h-11" src="{{ banner_icon_url }}" width="40" height="44" alt="" aria-hidden="true" />
			{% endif %}
			<h1 class="font-heading text-d1-sm uppercase text-birch md:text-d2 lg:text-d1-md lg:leading-[80px]">{{ title }}</h1>
		</div>
	</div>
</section>

