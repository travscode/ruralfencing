{% set theme_uri = function('get_stylesheet_directory_uri') %}

<section class="bg-eggshell px-6 pb-[100px] lg:px-[100px] lg:pb-[140px]">
	<div class="mx-auto w-full max-w-[1140px] border-t border-deep-green pt-5">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-t3 font-bold text-birch">
				Share this post:
			</p>

			<div class="flex flex-wrap items-center gap-[10px]">
				<button
					class="article-share-link"
					type="button"
					aria-label="Copy article link"
					data-copy-article-link="{{ share_url|e('html_attr') }}"
				>
					<img class="h-[50px] w-[50px]" src="{{ theme_uri }}/images/share-copy.svg" width="50" height="50" alt="" />
				</button>

				{% for item in share_links %}
					<a
						class="article-share-link"
						href="{{ item.url }}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="{{ item.label == 'ChatGPT' ? 'Summarise with ChatGPT' : 'Share on ' ~ item.label }}"
					>
						<img class="h-[50px] w-[50px]" src="{{ theme_uri }}/images/share-{{ item.icon }}.svg" width="50" height="50" alt="" />
					</a>
				{% endfor %}
			</div>
		</div>
		<p class="sr-only" role="status" data-copy-article-status></p>
	</div>
</section>
