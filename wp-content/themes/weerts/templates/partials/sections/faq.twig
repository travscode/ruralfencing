{% set section_title = title|default('') %}
{% set items = items|default([]) %}
{% set items_per_column = ((items|length) / 2)|round(0, 'ceil') %}
{% if items_per_column < 1 %}{% set items_per_column = 1 %}{% endif %}
{% set columns = items|batch(items_per_column, null) %}

<section class="rural-faq px-6 pb-20 lg:px-[100px] lg:pb-[180px]">
	<div class="mx-auto flex w-full max-w-[1720px] flex-col gap-8 lg:gap-[60px]">
		<div class="flex items-center gap-4 lg:gap-10">
			<div class="h-1 w-6 flex-none bg-deep-green lg:w-10" aria-hidden="true"></div>
			<h2 class="font-heading text-d2-sm uppercase text-birch lg:text-d2 lg:leading-[58px]">{{ section_title }}</h2>
		</div>

		<div class="grid gap-x-[60px] lg:grid-cols-2">
			{% for column in columns %}
				<div>
					{% for item in column %}
						{% if item %}
							<details class="wp-block-details">
								<summary>{{ item.question }}</summary>
								<div class="text-t1 leading-[26px] text-birch">{{ item.answer|raw }}</div>
							</details>
						{% endif %}
					{% endfor %}
				</div>
			{% endfor %}
		</div>
	</div>
</section>
