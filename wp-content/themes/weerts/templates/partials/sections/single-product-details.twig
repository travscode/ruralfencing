<section class="product-details bg-eggshell px-6 pb-[180px] lg:px-[100px]">
	<div class="mx-auto w-full max-w-[1720px]">
		<div class="flex flex-col gap-10 lg:flex-row lg:gap-[165px]">
			<div class="w-full lg:w-[850px]">
				<div class="relative overflow-hidden rounded-xl bg-white">
					{% if product_badge %}
						<span class="weerts-product-badge {% if product_badge|lower in ['special', 'specials', 'sale'] %}weerts-product-badge--specials{% endif %} absolute left-[18px] top-[18px] z-10 bg-goldenrod text-birch">{{ product_badge }}</span>
					{% endif %}

					{% if image_url %}
						<img class="h-[420px] w-full object-cover lg:h-[600px]" src="{{ image_url }}" alt="" />
					{% endif %}
				</div>
			</div>

			<div class="w-full lg:w-[705px]">
				<div class="flex flex-col gap-10">
					<div class="flex flex-col gap-6">
						{% if sku or variation_ui %}
							<p class="text-t1 leading-[26px] text-deep-green">SKU: <span data-product-sku>{{ sku }}</span></p>
						{% endif %}

						<h1 class="font-heading text-d2 uppercase leading-[58px] text-birch">{{ title }}</h1>
					</div>

					<div class="h-1 w-10 bg-deep-green"></div>

					<div class="flex items-center gap-3" data-product-price>
						{% if sale_price_html and regular_price_html %}
							<p class="text-[28px] leading-[30px] text-terracotta-clay line-through">{{ regular_price_html|raw }}</p>
							<p class="text-[28px] font-bold leading-[30px] text-terracotta-clay">{{ sale_price_html|raw }}</p>
						{% else %}
							<p class="text-[28px] font-bold leading-[30px] text-terracotta-clay">{{ price_html|raw }}</p>
						{% endif %}
					</div>

					{% if variation_ui %}
						<div class="flex flex-col gap-6">
							{% set vlabel = variation_ui.label|lower %}
							<p class="text-t4 font-bold leading-[30px] text-birch">Select {{ vlabel|first in ['a', 'e', 'i', 'o', 'u'] ? 'an' : 'a' }} {{ vlabel }}:</p>

							<div class="flex flex-wrap gap-3" data-variation-attribute="{{ variation_ui.name }}" role="group" aria-label="{{ variation_ui.label }}">
								{% for opt in variation_ui.buttons %}
									<button
										type="button"
										class="rounded-md border px-3 py-3 text-b1 transition-colors hover:border-deep-green {{ opt.selected ? 'border-deep-green bg-deep-green text-white' : 'border-birch text-birch hover:text-deep-green' }} {{ not opt.in_stock ? 'is-out-of-stock' : '' }}"
										data-variation-value="{{ opt.value }}"
										{% if opt.selected %}data-selected aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
										{% if not opt.in_stock %}title="Out of stock"{% endif %}
									>
										{{ opt.label }}{% if not opt.in_stock %}<span class="ml-2 text-t8 opacity-70">(out of stock)</span>{% endif %}
									</button>
								{% endfor %}
							</div>
							<p class="hidden text-t7 font-medium leading-[23px]" data-variation-stock aria-live="polite"></p>
						</div>
					{% endif %}

					<div class="rural-product__buy flex flex-col gap-4 pt-5 lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-6 lg:gap-y-4">
						{% if enquire_only %}
							<button
								class="rural-button"
								type="button"
								data-enquiry-open
							>
								<span class="flex items-center bg-goldenrod px-[26px] py-7 text-birch" aria-hidden="true">
									{% include 'icons/phone.twig' with { class: 'h-6 w-6' } %}
								</span>
								<span class="flex items-center bg-white py-8 pl-[30px] pr-[60px] font-heading text-b3 uppercase tracking-button text-birch">Product Enquiry</span>
							</button>
						{% else %}
							{{ add_to_cart_html|raw }}
							<button class="rural-category-spotlight__pill" type="button" data-enquiry-open>Or Contact Us</button>
						{% endif %}
					</div>

					<div class="flex flex-col">
						<details class="border-t border-birch py-9">
							<summary class="flex cursor-pointer list-none items-center justify-between font-heading text-d3 uppercase leading-[38px] text-birch">
								<span>Product Details</span>
								<span class="text-goldenrod">{% include 'icons/faq-plus.twig' with { class: 'h-5 w-5' } %}</span>
							</summary>
							<div class="mt-6 text-t1 leading-[26px] text-birch">
								{{ product.get_description|wpautop }}
							</div>
						</details>

						<details class="border-t border-birch py-9">
							<summary class="flex cursor-pointer list-none items-center justify-between font-heading text-d3 uppercase leading-[38px] text-birch">
								<span>Specifications</span>
								<span class="text-goldenrod">{% include 'icons/faq-plus.twig' with { class: 'h-5 w-5' } %}</span>
							</summary>
							<div class="mt-6 text-t1 leading-[26px] text-birch">
								{% if spec_lines and spec_lines|length %}
									<ul class="flex flex-col gap-3">
										{% for line in spec_lines %}
											<li><strong>{{ line.name }}:</strong> {{ line.value }}</li>
										{% endfor %}
									</ul>
								{% else %}
									<p>No specifications listed.</p>
								{% endif %}
							</div>
						</details>

						<details class="border-y border-birch py-9">
							<summary class="flex cursor-pointer list-none items-center justify-between font-heading text-d3 uppercase leading-[38px] text-birch">
								<span>Pick up &amp; Delivery</span>
								<span class="text-goldenrod">{% include 'icons/faq-plus.twig' with { class: 'h-5 w-5' } %}</span>
							</summary>
							<div class="mt-6 text-t1 leading-[26px] text-birch">
								<p>Pick up is available from our store. Delivery options may vary by product size and location.</p>
							</div>
						</details>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
