{% set section_title = title|default('') %}
{% set body_html = body_html|default('') %}
{% set action_url = action_url|default(function('home_url', '/')) %}
{% set icon_url = icon_url|default('') %}
{% set input_id = input_id|default('rural-search-strip-field') %}

<section class="rural-search-strip px-6 pb-20 lg:pb-[180px]">
	<div class="mx-auto w-full max-w-[1720px] rounded-xl bg-goldenrod px-5 py-8 lg:px-20 lg:py-20">
		<div class="flex flex-col items-stretch justify-between gap-8 lg:flex-row lg:items-center lg:gap-[112px]">
			<div class="flex w-full flex-col gap-4 lg:w-[678px] lg:gap-[30px]">
				<h2 class="font-heading text-d2-sm uppercase text-birch lg:text-d2 lg:leading-[58px]">{{ section_title }}</h2>

				{% if body_html %}
					<div class="text-t1 leading-[26px] text-birch">{{ body_html|raw }}</div>
				{% endif %}
			</div>

			<form class="rural-search-strip__form w-full md:max-w-1/2" role="search" method="get" action="{{ action_url }}" aria-label="Search products">
				<div class="rural-search-strip__bar">
					<label class="sr-only" for="{{ input_id }}">Search</label>
					<input
						id="{{ input_id }}"
						class="rural-search-strip__field"
						type="search"
						name="s"
						placeholder="What can we help you find today?"
						data-placeholder-mobile="Search products"
						data-advanced-search-input
					/>
					<button class="rural-search-strip__submit" type="button" aria-label="Search options" title="Search options" data-advanced-search-trigger>
						{% include 'icons/search-dropdown.twig' with { class: 'h-[26px] w-[26px] lg:h-[34px] lg:w-[34px]' } %}
					</button>
				</div>
			</form>
		</div>
	</div>
</section>
