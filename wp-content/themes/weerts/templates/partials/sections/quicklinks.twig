{% set eyebrow = eyebrow|default('') %}
{% set section_title = title|default('') %}
{% set cards = cards|default([]) %}

<section class="rural-quicklinks bg-white px-6 lg:px-[90px]">
	<div class="mx-auto flex w-full max-w-[1740px] flex-col items-center gap-10 py-16 md:gap-[60px] lg:pt-[140px] lg:pb-[180px]">
		<div class="flex w-full items-center gap-5 md:gap-10">
			{% include 'icons/horiz-line.twig' with { class: 'h-1 w-10 shrink-0 text-deep-green' } %}
			<div>
				{% if eyebrow %}
					<p class="text-t7 uppercase tracking-button text-deep-green">{{ eyebrow }}</p>
				{% endif %}
				<h2 class="font-heading text-d2 uppercase leading-[58px] text-birch">{{ section_title }}</h2>
			</div>
		</div>

		<div class="grid w-full gap-5 lg:grid-cols-3">
			{% for card in cards %}
				<a class="group flex h-full flex-col no-underline" href="{{ card.href|default('#') }}">
					<div class="shrink-0 overflow-hidden rounded-xl">
						<img class="h-[260px] w-full object-cover transition-transform duration-200 group-hover:scale-[1.02] lg:h-[315px]" src="{{ card.image_url }}" alt="" />
					</div>
					<div class="mt-[10px] flex flex-1 items-start gap-6 rounded-xl bg-eggshell pb-10 pr-6 pt-8 xl:pb-[60px] xl:pr-[60px] xl:pt-10">
						<div class="flex h-[50px] w-[50px] shrink-0 items-center justify-center bg-goldenrod text-birch">
							{% include 'icons/arrow-right.twig' with { class: 'h-3 w-3' } %}
						</div>
						<div class="min-w-0 flex-1 pt-[6px]">
							<h3 class="font-heading text-d3 uppercase leading-[38px] text-birch">{{ card.title }}</h3>
							<p class="mt-6 text-t1 leading-[26px] text-birch">{{ card.text }}</p>
						</div>
					</div>
				</a>
			{% endfor %}
		</div>
	</div>
</section>
