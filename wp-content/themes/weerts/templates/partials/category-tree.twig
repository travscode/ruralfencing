<ul class="category-tree">
{% for item in items %}
	<li>{% if item.children %}<details><summary>{{ item.name }}</summary><a href="{{ item.link }}">View all {{ item.name }}</a>{% include 'partials/category-tree.twig' with { items: item.children } only %}</details>{% else %}<a href="{{ item.link }}">{{ item.name }}</a>{% endif %}</li>
{% endfor %}
</ul>
