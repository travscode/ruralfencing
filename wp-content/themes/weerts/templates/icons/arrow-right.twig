{% set svg_title = title|default(null) %}
<svg
	class="{{ class|default('') }}"
	width="12"
	height="12"
	viewBox="0 0 13.2803 14.1213"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	{% if svg_title %}
		role="img"
		aria-label="{{ svg_title|e }}"
	{% else %}
		aria-hidden="true"
	{% endif %}
>
	{% if svg_title %}
		<title>{{ svg_title }}</title>
	{% endif %}
	<path d="M0.75 7.06068H11.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="bevel" />
	<path d="M6.75 1.06066L12.75 7.06066L6.75 13.0607" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="bevel" />
</svg>
