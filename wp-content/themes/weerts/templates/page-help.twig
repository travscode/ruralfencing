{% extends 'base.twig' %}

{% block content %}
    {% set theme_uri = function('get_stylesheet_directory_uri') %}
    {% include 'partials/sections/internal-banner.twig' with {
        title: 'Helpful Info',
        background_url: theme_uri ~ '/images/helpful-electric-horse-banner-bg-aced98.png'
    } only %}

    <section class="px-6 py-16 lg:px-[100px]">
        <div class="mx-auto w-full max-w-[1720px]">
            <p class="max-w-[850px] text-t1 leading-[26px]">Practical guides for planning fencing, gates, irrigation and projects around your property. Explore the topics below, or bring your measurements and plans to our team for help choosing products.</p>
        </div>
    </section>

    {% if help_cards %}
        {% include 'partials/sections/quicklinks.twig' with {
            title: 'Explore our guides', cards: help_cards
        } only %}
    {% endif %}

    {% include 'partials/sections/cta-primary.twig' with {
        title: 'Not sure what you need?',
        body: 'Tell us what you are working on and bring your measurements or plans. Our team can help you work through the options.',
        button_label: 'Get in touch', button_url: site.url ~ '/contact/',
        image_url: theme_uri ~ '/images/cta-primary.png'
    } only %}
{% endblock %}
